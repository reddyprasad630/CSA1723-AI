from collections import deque

def solve_water_jug(jug1_cap, jug2_cap, target):
    # Keep track of visited states: (amt_in_jug1, amt_in_jug2)
    visited = set()
    # Queue for BFS stores: (amt_in_jug1, amt_in_jug2, list_of_steps_taken)
    queue = deque([(0, 0, [])])

    # Helper to format steps
    def get_step_desc(state, action):
        return f"{action:<30} -> Jug 1: {state[0]}L, Jug 2: {state[1]}L"

    # If target is greater than both jug capacities, it's impossible
    if target > max(jug1_cap, jug2_cap):
        return None

    # Greatest Common Divisor check for solvability
    def gcd(a, b):
        while b:
            a, b = b, a % b
        return a

    if target % gcd(jug1_cap, jug2_cap) != 0:
        return None

    while queue:
        j1, j2, steps = queue.popleft()

        # If either jug has reached the target volume
        if j1 == target or j2 == target:
            return steps

        if (j1, j2) in visited:
            continue
        visited.add((j1, j2))

        # Define all possible rule transitions
        transitions = [
            # 1. Fill Jug 1
            (jug1_cap, j2, "Fill Jug 1"),
            # 2. Fill Jug 2
            (j1, jug2_cap, "Fill Jug 2"),
            # 3. Empty Jug 1
            (0, j2, "Empty Jug 1"),
            # 4. Empty Jug 2
            (j1, 0, "Empty Jug 2"),
            # 5. Pour Jug 1 -> Jug 2
            (j1 - min(j1, jug2_cap - j2), j2 + min(j1, jug2_cap - j2), "Pour Jug 1 into Jug 2"),
            # 6. Pour Jug 2 -> Jug 1
            (j1 + min(j2, jug1_cap - j1), j2 - min(j2, jug1_cap - j1), "Pour Jug 2 into Jug 1")
        ]

        for next_j1, next_j2, action in transitions:
            if (next_j1, next_j2) not in visited:
                step_record = get_step_desc((next_j1, next_j2), action)
                queue.append((next_j1, next_j2, steps + [step_record]))

    return None

