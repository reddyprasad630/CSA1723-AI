import calendar

# Define the year and month
year = 2023
month = 10  # October

# Generate the text-based calendar for the given month and year
month_calendar = calendar.month(year, month)

print(f"--- Calendar for {calendar.month_name[month]} {year} ---\n")
print(month_calendar)

